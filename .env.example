# Keep .env and .env.local private. Docker Compose reads .env; Next.js reads .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=merit_track
DB_USER=merittrack
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA=

# Local is the development default. Use onedrive only after Microsoft Graph is configured.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SITE_ID=
MICROSOFT_DRIVE_ID=
MICROSOFT_STORAGE_ROOT=MeritTrack/evidence

# Console keeps development usable without email credentials. Production uses resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="MeritTrack <noreply@notify.example.com>"
RESEND_WEBHOOK_SECRET=
PASSWORD_RESET_SECRET=


