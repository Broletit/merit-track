{
    "name":  "merit-track",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "mobile:share":  "node scripts/mobile-share.cjs",
                    "mobile:stop":  "node scripts/mobile-share.cjs --stop",
                    "predev":  "node scripts/prepare-qr.cjs",
                    "prebuild":  "node scripts/prepare-qr.cjs",
                    "db:up":  "docker compose --env-file .env.local up -d",
                    "db:init":  "tsx scripts/db-init.ts",
                    "db:migrate":  "tsx scripts/migrate-sqlite-to-mysql.ts",
                    "db:seed":  "tsx scripts/db-seed.ts",
    "db:upgrade": "tsx scripts/db-upgrade.ts",
    "reports:refresh-cache": "tsx scripts/refresh-report-assessment-cache.ts",
                    "storage:migrate-private":  "tsx scripts/migrate-public-uploads-to-private-storage.ts",
                    "typecheck":  "tsc --noEmit",
                    "storage:cleanup":  "tsx scripts/storage-cleanup.ts",
                    "storage:migrate-onedrive":  "tsx scripts/migrate-local-files-to-onedrive.ts"
                },
    "dependencies":  {
                         "@yudiel/react-qr-scanner":  "^2.6.0",
                         "barcode-detector":  "3.2.2",
                         "bcryptjs":  "^3.0.3",
                         "clsx":  "^2.1.1",
                         "csv-parse":  "^6.2.1",
                         "date-fns":  "^4.1.0",
                         "dotenv":  "^18.0.9",
                         "html5-qrcode":  "^2.3.8",
                         "lucide-react":  "^1.8.0",
                         "mysql2":  "^3.24.6",
                         "nanoid":  "^5.1.7",
                         "next":  "16.2.2",
                         "react":  "19.2.4",
                         "react-dom":  "19.2.4",
                         "react-hot-toast":  "^2.6.0",
                         "react-qr-code":  "^2.0.18",
                         "resend":  "^6.35.0",
                         "svix":  "^2.9.1",
                         "xlsx":  "^0.18.5",
                         "zod":  "^4.3.6"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4",
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/node":  "^20",
                            "@types/react":  "^19",
